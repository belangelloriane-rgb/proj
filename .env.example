# Copy this file to ".env" and change the values to match your MySQL setup.
# (On Vercel, add these same names under Project Settings > Environment Variables instead.)

# --- Local MySQL (XAMPP, Laragon, MySQL Server) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db
PORT=3000

# --- Cloud MySQL (e.g. TiDB Cloud): set this to true ---
# DB_SSL=true

# Timezone used for "today" and overdue dates (default: Asia/Manila)
# APP_TIMEZONE=Asia/Manila
